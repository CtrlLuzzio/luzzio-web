---
import { Icon } from "astro-icon/components";
import { getLocale, useTranslations } from "../i18n/utils";

const { class: className } = Astro.props;
const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
---

<div class:list={["flex flex-col lg:flex-row gap-6", className]}>
  <a
    href="https://www.twitch.tv/luzzio__"
    target="_blank"
    rel="noopener noreferrer"
    class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 p-8 rounded-2xl bg-catp-base border-2 border-transparent hover:border-[#9146FF] transition-colors w-full lg:flex-1"
  >
    <div class="flex flex-col gap-4">
      <div class="flex items-center gap-3">
        <Icon name="tabler:brand-twitch" class="w-8 h-8 text-[#9146FF]" />
        <h3 class="text-2xl font-mono font-bold">
          {t.twitch.title}
        </h3>
      </div>
      <p class="text-catp-subtext-0 max-w-2xl">
        {t.twitch.desc}
      </p>
    </div>

    <div
      class="twitch-status-badge flex items-center gap-3 px-5 py-3 bg-catp-crust rounded-full border border-catp-surface-0 shrink-0"
    >
      <span
        class="twitch-status-dot w-3 h-3 rounded-full bg-catp-text opacity-50"
      ></span>
      <span
        class="twitch-status-text font-mono font-bold text-sm"
        data-live-text={t.twitch.live}
      >
        {t.twitch.offline}
      </span>
    </div>
  </a>
</div>