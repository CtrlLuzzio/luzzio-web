---
import { Icon } from "astro-icon/components";
import type { Page } from "astro";
import { getLocale, useTranslations } from "../i18n/utils";

interface Props {
  page: Page<unknown>;
}

const { page } = Astro.props;
const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);

const pageIndicator = t.pagination.pageOf
  .replace("{current}", String(page.currentPage))
  .replace("{total}", String(page.lastPage));
---

{
  page.lastPage > 1 && (
    <nav
      aria-label={t.pagination.navAria}
      class="flex items-center justify-between mt-12 pt-8 border-t border-catp-surface-2 font-mono"
    >
      {page.url.prev ? (
        <a
          href={page.url.prev}
          aria-label={t.pagination.prevAria}
          class="flex items-center gap-2 px-6 py-3 bg-catp-base hover:bg-catp-crust rounded-lg transition-colors border border-catp-surface-0 hover:border-catp-surface-2"
        >
          <Icon name="tabler:arrow-left" class="w-5 h-5" />
          <span class="hidden md:inline">{t.pagination.prev}</span>
        </a>
      ) : (
        <div
          aria-disabled="true"
          class="px-6 py-3 opacity-30 cursor-not-allowed flex items-center gap-2"
        >
          <Icon name="tabler:arrow-left" class="w-5 h-5" />
          <span class="hidden md:inline">{t.pagination.prev}</span>
        </div>
      )}

      <span class="text-catp-subtext-0">{pageIndicator}</span>

      {page.url.next ? (
        <a
          href={page.url.next}
          aria-label={t.pagination.nextAria}
          class="flex items-center gap-2 px-6 py-3 bg-catp-base hover:bg-catp-crust rounded-lg transition-colors border border-catp-surface-0 hover:border-catp-surface-2"
        >
          <span class="hidden md:inline">{t.pagination.next}</span>
          <Icon name="tabler:arrow-right" class="w-5 h-5" />
        </a>
      ) : (
        <div
          aria-disabled="true"
          class="px-6 py-3 opacity-30 cursor-not-allowed flex items-center gap-2"
        >
          <span class="hidden md:inline">{t.pagination.next}</span>
          <Icon name="tabler:arrow-right" class="w-5 h-5" />
        </div>
      )}
    </nav>
  )
}