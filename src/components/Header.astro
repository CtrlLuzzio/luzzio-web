---
import Navigation from "./Navigation.astro";
import Menu from "./Menu.astro";
import ThemeDropdown from "./ThemeDropdown.astro";
import LanguageDropdown from "./LanguageDropdown.astro";
import { getLocale, localizePath } from "../i18n/utils";

const lang = getLocale(Astro.currentLocale);
---

<header
  class="sticky lg:relative top-0 bg-catp-base border-b lg:border-b-2 border-catp-surface-0 py-4 px-4 lg:px-20 z-50"
>
  <nav class="flex justify-between items-center relative z-50">
    <a
      href={localizePath("/", lang)}
      class="text-[2.5rem] font-mono font-bold m-0 whitespace-nowrap shrink-0"
    >
      Luzzio
    </a>

    <div class="flex items-center gap-1.5 lg:gap-2">
      <div
        id="menu-backdrop"
        class="fixed inset-0 bg-catp-crust/80 backdrop-blur-sm z-30 opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
      >
      </div>

      <div
        id="mobile-menu"
        class:list={[
          "fixed top-0 right-0 z-40 w-[75vw] h-screen",
          "flex flex-col items-center justify-center",
          "bg-catp-base border-l border-catp-surface-0",
          "transition-all duration-300 translate-x-full shadow-none shadow-catp-shadow",
          "lg:static lg:w-auto lg:h-auto lg:flex-row lg:justify-end",
          "lg:bg-transparent lg:border-0 lg:shadow-none lg:translate-x-0",
        ]}
      >
        <Navigation />
      </div>

      <div
        class="hidden lg:block h-6 w-0.5 bg-catp-surface-1 mx-1"
        aria-hidden="true"
      >
      </div>

      <div class="relative z-20 flex items-center gap-1">
        <ThemeDropdown />
        <LanguageDropdown />
      </div>

      <Menu />
    </div>
  </nav>
</header>