---
const { id, title, class: className } = Astro.props;
---
<section
  id={id}
  class:list={[
    "bg-mocha-surface-0 rounded-3xl p-8 md:p-12 shadow-xl shadow-mocha-crust/20 flex flex-col gap-8 md:gap-12 mb-20",
    className
  ]}
>
  <div class="flex items-center gap-4 w-full">
    <h3 class="text-4xl font-mono font-bold text-mocha-mauve">{title}</h3>
    <div class="h-0.5 flex-1 bg-mocha-base opacity-50"></div>
  </div>
  
  <slot />
</section>