---
import Social from './SocialMedia.astro';
---

<footer class="flex flex-col gap-8 font-sans">
    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <nav aria-label="Navegación del pie de página">
            <h4 class="font-mono font-bold mb-4">Explore</h4>
            <ul class="list-none p-0 m-0 flex flex-col gap-2">
                <li><a href="/" class="text-[#cdd6f4] hover:text-[#a6e3a1] transition-colors">Home</a></li>
                <li><a href="/blog" class="text-[#cdd6f4] hover:text-[#a6e3a1] transition-colors">Blog</a></li>
                <li><a href="/portfolio" class="text-[#cdd6f4] hover:text-[#a6e3a1] transition-colors">Portfolio</a></li>
                <li><a href="/contact" class="text-[#cdd6f4] hover:text-[#a6e3a1] transition-colors">Contact</a></li>
            </ul>
        </nav>
        
        <address class="not-italic flex flex-col gap-2">
            <h4 class="font-mono font-bold mb-4">Social</h4>
            <Social url="https://www.twitch.tv/luzzio__" string="Twitch" icon="simple-icons:twitch" />
            <Social url="https://www.tiktok.com/@luzzio__" string="TikTok" icon="simple-icons:tiktok" />
            <Social url="https://www.github.com/CtrlLuzzio" string="Github" icon="simple-icons:github" />
            <Social url="https://www.linktr.ee/luzzio" string="Linktree" icon="simple-icons:linktree" />
        </address>

        <div class="flex flex-col">
            <h4 class="font-mono font-bold mb-4">Source</h4>
            <a href="https://github.com/CtrlLuzzio/luzzio-web" target="_blank" rel="noopener noreferrer" class="text-[#cdd6f4] hover:text-[#a6e3a1] transition-colors">
                Check the code of this website here
            </a>
            <p class="text-xs text-[#cdd6f4] mt-1">
                Made with Astro and Tailwind CSS.
            </p>
        </div>
    </section>

    <small class="block border-t-[1px] border-[#313244] pt-6 text-center opacity-75">
        &copy; 2026 Luzzio. Code under MIT License. All rights reserved for content and multimedia.
    </small>
    <style>
        small {
            color: #cdd6f4;
        }
        h4 {
            font-size: 1.25rem;
            color: #cdd6f4;
        }
    </style>
</footer>