---
import Social from "./SocialMedia.astro";
import Link from "./Link.astro";
import { getLocale, localizePath, useTranslations } from "../i18n/utils";

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
---

<footer
  class="flex flex-col gap-8 font-sans bg-catp-base border-t lg:border-t-2 border-catp-surface-0 py-4 px-4 md:px-10 lg:px-20"
>
  <section class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4">
    <nav aria-label="Footer Navigation">
      <h4 class="text-2xl font-mono font-bold mb-4">{t.footer.explore}</h4>
      <ul class="list-none p-0 m-0 grid grid-cols-2 gap-x-4 gap-y-2">
        <li>
          <Link href={localizePath("/", lang)}>{t.nav.home}</Link>
        </li>
        <li>
          <Link href={localizePath("/services", lang)}>{t.nav.services}</Link>
        </li>
        <li>
          <Link href={localizePath("/results", lang)}>{t.nav.results}</Link>
        </li>
        <li>
          <Link href={localizePath("/projects", lang)}>{t.nav.projects}</Link>
        </li>
        <li>
          <Link href={localizePath("/blog", lang)}>{t.nav.blog}</Link>
        </li>
        <li>
          <Link href={localizePath("/contact", lang)}>{t.nav.contact}</Link>
        </li>
      </ul>
    </nav>
    <address class="not-italic">
      <h4 class="text-2xl font-mono font-bold mb-4">{t.footer.social}</h4>
      <ul class="list-none p-0 m-0 grid grid-cols-2 gap-x-4 gap-y-2">
        <li>
          <Social
            url="https://www.twitch.tv/luzzio__"
            string="Twitch"
            icon="tabler:brand-twitch"
          />
        </li>
        <li>
          <Social
            url="https://www.github.com/CtrlLuzzio"
            string="Github"
            icon="tabler:brand-github"
          />
        </li>
        <li>
          <Social
            url="https://www.tiktok.com/@luzzio__"
            string="TikTok"
            icon="tabler:brand-tiktok"
          />
        </li>
        <li>
          <Social
            url="https://www.youtube.com/@soyluzzio"
            string="YouTube"
            icon="tabler:brand-youtube"
          />
        </li>
        <li>
          <Social
            url="https://discord.gg/bWVhNR6cpx"
            string="Discord"
            icon="tabler:brand-discord"
          />
        </li>
        <li>
          <Social
            url="https://www.instagram.com/luzzio__"
            string="Instagram"
            icon="tabler:brand-instagram"
          />
        </li>
      </ul>
    </address>
    <div>
      <h4 class="text-2xl font-mono font-bold mb-4">{t.footer.source}</h4>
      <div class="flex flex-col gap-2">
        <Link
          href="https://github.com/CtrlLuzzio/luzzio-web"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.footer.sourceLink}
        </Link>
        <p class="text-xs m-0 text-catp-subtext-0">
          {t.footer.madeWith}
        </p>
      </div>
    </div>
  </section>
  <small
    class="block pt-6 text-center border-t border-catp-surface-0 text-catp-subtext-0"
  >
    {t.footer.copyright}
  </small>
</footer>