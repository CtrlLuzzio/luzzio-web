---
import Social from "./SocialMedia.astro";
---

<footer class="flex flex-col gap-8 font-sans">
  <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <nav aria-label="Navegación del pie de página">
      <h4 class="font-mono font-bold mb-4">Explore</h4>
      <ul class="list-none p-0 m-0 flex flex-col gap-2">
        <li>
          <a
            href="/"
            class="transition-colors hover:text-mocha-green focus:text-mocha-green"
          >
            Home
          </a>
        </li>
        <li>
          <a
            href="/blog"
            class="transition-colors hover:text-mocha-green focus:text-mocha-green"
          >
            Blog
          </a>
        </li>
        <li>
          <a
            href="/portfolio"
            class="transition-colors hover:text-mocha-green focus:text-mocha-green"
          >
            Portfolio
          </a>
        </li>
        <li>
          <a
            href="/contact"
            class="transition-colors hover:text-mocha-green focus:text-mocha-green"
          >
            Contact
          </a>
        </li>
      </ul>
    </nav>

    <address class="not-italic flex flex-col gap-2">
      <h4 class="font-mono font-bold mb-4">Social</h4>
      <Social
        url="https://www.twitch.tv/luzzio__"
        string="Twitch"
        icon="simple-icons:twitch"
      />
      <Social
        url="https://www.tiktok.com/@luzzio__"
        string="TikTok"
        icon="simple-icons:tiktok"
      />
      <Social
        url="https://www.github.com/CtrlLuzzio"
        string="Github"
        icon="simple-icons:github"
      />
      <Social
        url="https://www.linktr.ee/luzzio"
        string="Linktree"
        icon="simple-icons:linktree"
      />
    </address>

    <div class="flex flex-col">
      <h4 class="font-mono font-bold mb-4">Source</h4>
      <a
        href="https://github.com/CtrlLuzzio/luzzio-web"
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors hover:text-mocha-green focus:text-mocha-green"
      >
        Check the code of this website here
      </a>
      <p class="text-xs mt-1">Made with Astro and Tailwind CSS.</p>
    </div>
  </section>

  <small class="block pt-6 text-center">
    &copy; 2026 Luzzio. Code under MIT License. All rights reserved for content
    and multimedia.
  </small>
</footer>
<style>
  footer {
    background-color: #1e1e2e;
    border-top: 2px #313244 solid;
    padding: 1rem 5rem;
  }

  small {
    border-top: 1px solid #313244;
    opacity: 0.75;
    color: #cdd6f4;
  }

  h4 {
    font-size: 1.25rem;
  }
</style>
