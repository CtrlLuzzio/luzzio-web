---
import Social from "./SocialMedia.astro";
import Link from "./Link.astro";
---

<footer
  class="flex flex-col gap-8 font-sans bg-mocha-base border-t-2 border-mocha-surface-0 py-4 px-20"
>
  <section class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4">
    <nav aria-label="Footer Navigation">
      <h4 class="text-2xl font-mono font-bold mb-4">Explore</h4>
      <ul class="list-none p-0 m-0 flex flex-col gap-2">
        <li>
          <Link href="/">Home</Link>
        </li>
        <li><Link href="/blog">Blog</Link></li>
        <li>
          <Link href="/projects">Projects</Link>
        </li>
        <li>
          <Link href="/contact">Contact</Link>
        </li>
      </ul>
    </nav>

    <address class="not-italic">
      <h4 class="text-2xl font-mono font-bold mb-4">Social</h4>
      <ul class="list-none p-0 m-0 grid grid-cols-2 gap-x-4 gap-y-2">
        <li>
          <Social
            url="https://www.twitch.tv/luzzio__"
            string="Twitch"
            icon="tabler:brand-twitch"
          />
        </li>
        <li>
          <Social
            url="https://www.github.com/CtrlLuzzio"
            string="Github"
            icon="tabler:brand-github"
          />
        </li>
        <li>
          <Social
            url="https://www.tiktok.com/@luzzio__"
            string="TikTok"
            icon="tabler:brand-tiktok"
          />
        </li>
        <li>
          <Social
            url="https://www.youtube.com/@soyluzzio"
            string="YouTube"
            icon="tabler:brand-youtube"
          />
        </li>
        <li>
          <Social
            url="https://x.com/luzzio__"
            string="Twitter"
            icon="tabler:brand-x"
          />
        </li>
        <li>
          <Social
            url="https://www.instagram.com/luzzio__"
            string="Instagram"
            icon="tabler:brand-instagram"
          />
        </li>
      </ul>
    </address>

    <div>
      <h4 class="text-2xl font-mono font-bold mb-4">Source</h4>
      <div class="flex flex-col gap-2">
        <Link
          href="https://github.com/CtrlLuzzio/luzzio-web"
          target="_blank"
          rel="noopener noreferrer"
        >
          Check the code of this website here
        </Link>
        <p class="text-xs m-0 opacity-75">
          Made with Astro and Tailwind CSS.
        </p>
      </div>
    </div>
  </section>

  <small
    class="block pt-6 text-center border-t border-mocha-surface-0 opacity-75 text-mocha-text"
  >
    &copy; 2026 Luzzio. Code under MIT License. All rights reserved for content
    and multimedia.
  </small>
</footer>
