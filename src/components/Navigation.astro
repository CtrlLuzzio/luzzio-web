---
import NavLink from "./NavLink.astro";
import { getLocale, localizePath, useTranslations } from "../i18n/utils";

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);

const navClasses =
  "block w-full text-center px-4 py-4 lg:py-2 rounded-lg text-2xl lg:text-lg font-bold transition-all hover:bg-catp-surface-0";
---

<div
  class="flex flex-col lg:flex-row items-center justify-center gap-8 lg:gap-2 m-0 font-mono w-full lg:w-auto px-8 lg:px-0"
>
  <NavLink class:list={[navClasses, "lg:hidden"]} href={localizePath("/", lang)} showActive>
    {t.nav.home}
  </NavLink>
  <NavLink class={navClasses} href={localizePath("/services", lang)} showActive>
    {t.nav.services}
  </NavLink>
  <NavLink class={navClasses} href={localizePath("/results", lang)} showActive>
    {t.nav.results}
  </NavLink>
  <NavLink class={navClasses} href={localizePath("/blog", lang)} showActive>
    {t.nav.blog}
  </NavLink>
  <NavLink class={navClasses} href={localizePath("/projects", lang)} showActive>
    {t.nav.projects}
  </NavLink>
  <NavLink class={navClasses} href={localizePath("/contact", lang)} showActive>
    {t.nav.contact}
  </NavLink>
</div>