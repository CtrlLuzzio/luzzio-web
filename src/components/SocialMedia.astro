---
import { Icon } from "astro-icon/components";
const { url, string, icon } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="flex items-center gap-2 transition-colors hover:text-mocha-green"
>
  <Icon name={icon} class="w-5 h-5" />
  <span>{string}</span>
</a>
