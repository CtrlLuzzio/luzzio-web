---
import { Icon } from 'astro-icon/components';
const { url, string, icon } = Astro.props;
---
<a href={url} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-[#cdd6f4] hover:text-[#a6e3a1] transition-colors">
    <Icon name={icon} class="w-5 h-5" />
    <span>{string}</span>
</a>