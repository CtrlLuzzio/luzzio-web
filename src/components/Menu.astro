---
import { Icon } from "astro-icon/components";
---

<button
  id="menu-toggle"
  class="md:hidden flex items-center justify-center p-2 text-mocha-text hover:text-mocha-green transition-colors relative z-50 cursor-pointer"
  aria-label="Toggle menu"
  aria-expanded="false"
>
  <Icon name="tabler:menu-2" class="w-8 h-8 block" id="menu-icon-open" />
  <Icon name="tabler:x" class="w-8 h-8 hidden" id="menu-icon-close" />
</button>

<script src="../scripts/menu.ts"></script>