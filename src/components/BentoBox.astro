---
import { Icon } from "astro-icon/components";

const { href, icon, iconColor, title, class: className, ...props } = Astro.props;
---

<a
  href={href}
  class:list={[
    "flex flex-col gap-6 p-8 rounded-2xl bg-mocha-base border-2 border-transparent transition-colors",
    className,
  ]}
  {...props}
>
  <div class="flex items-center gap-3">
    <Icon name={icon} class:list={["w-8 h-8", iconColor]} />
    <h3 class="text-2xl font-mono font-bold">{title}</h3>
  </div>
  <p class="opacity-70 flex-1">
    <slot />
  </p>
</a>