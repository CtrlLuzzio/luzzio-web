---
const { href, class: className, showActive = false, ...props } = Astro.props;

const normalizePath = (p: string) =>
  p.length > 1 && p.endsWith("/") ? p.slice(0, -1) : p;

const currentPath = normalizePath(Astro.url.pathname);
const targetPath = normalizePath(href);
const isHome = targetPath === "/" || targetPath === "/es";

const isActive = isHome
  ? currentPath === targetPath
  : currentPath === targetPath || currentPath.startsWith(`${targetPath}/`);
---

<a
  href={href}
  aria-current={isActive && showActive ? "page" : undefined}
  class:list={[
    "transition-colors hover:bg-catp-surface-0",
    { "bg-catp-surface-0": isActive && showActive },
    className,
  ]}
  {...props}
>
  <slot />
</a>