---
const { href, class: className, showActive = false, ...props } = Astro.props;
const currentPath = Astro.url.pathname;
---

<a
  href={href}
  class:list={[
    "transition-colors hover:bg-mocha-surface-0",
    { "bg-mocha-surface-0": currentPath.includes(href) && showActive },
    className,
  ]}
  {...props}
>
  <slot />
</a>
