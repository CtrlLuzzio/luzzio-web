---
import { actions } from "astro:actions";

const result = Astro.getActionResult(actions.leads.submitProject);
---

<form
  method="POST"
  action={actions.leads.submitProject}
  class="flex flex-col gap-6 bg-mocha-base p-8 rounded-2xl border-2 border-mocha-surface-0 shadow-lg shadow-mocha-crust/50"
>
  {result?.data && (
    <div class="p-4 bg-mocha-green/10 border border-mocha-green text-mocha-green rounded-lg font-mono text-sm text-center">
      > {result.data.message}
    </div>
  )}
  {result?.error && (
    <div class="p-4 bg-mocha-red/10 border border-mocha-red text-mocha-red rounded-lg font-mono text-sm text-center">
      > Error: Verify the fields and try again
    </div>
  )}

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="flex flex-col gap-2">
      <label for="name" class="font-mono text-sm opacity-80 text-mocha-mauve">Name</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        class="bg-mocha-crust border border-mocha-surface-0 rounded-lg p-3 text-mocha-text focus:outline-none focus:border-mocha-mauve transition-colors"
      />
    </div>

    <div class="flex flex-col gap-2">
      <label for="email" class="font-mono text-sm opacity-80 text-mocha-mauve">Email</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        class="bg-mocha-crust border border-mocha-surface-0 rounded-lg p-3 text-mocha-text focus:outline-none focus:border-mocha-mauve transition-colors"
      />
    </div>

    <div class="flex flex-col gap-2">
      <label for="service" class="font-mono text-sm opacity-80 text-mocha-mauve">Service</label>
      <select
        id="service"
        name="service"
        required
        class="bg-mocha-crust border border-mocha-surface-0 rounded-lg p-3 text-mocha-text focus:outline-none focus:border-mocha-mauve transition-colors appearance-none cursor-pointer"
      >
        <option value="" disabled selected>Select a Service...</option>
        <option value="static_page">Static Website</option>
        <option value="web_app">Web App</option>
        <option value="odoo_module">Custom Odoo Module</option>
        <option value="ui_ux">UI/UX Website Audit</option>
        <option value="devops">DevOps / Servers</option>
        <option value="creator_tools">Creator Tools</option>
        <option value="custom">Custom quotation</option>
      </select>
    </div>

    <div class="flex flex-col gap-2">
      <label for="budget" class="font-mono text-sm opacity-80 text-mocha-mauve">Budget (USD)</label>
      <select
        id="budget"
        name="budget"
        required
        class="bg-mocha-crust border border-mocha-surface-0 rounded-lg p-3 text-mocha-text focus:outline-none focus:border-mocha-mauve transition-colors appearance-none cursor-pointer"
      >
        <option value="" disabled selected>Estimated range...</option>
        <option value="under_500">Less than $500</option>
        <option value="500_1000">$500 - $1,000</option>
        <option value="1000_3000">$1,000 - $3,000</option>
        <option value="3000_plus">More than $3,000</option>
      </select>
    </div>
  </div>

  <div class="flex flex-col gap-2">
    <label for="deadline" class="font-mono text-sm opacity-80 text-mocha-mauve">Deadline (Optional)</label>
    <input
      type="text"
      id="deadline"
      name="deadline"
      placeholder="Ej: Towards the end of this month, there's no rush, etc."
      class="bg-mocha-crust border border-mocha-surface-0 rounded-lg p-3 text-mocha-text focus:outline-none focus:border-mocha-mauve transition-colors"
    />
  </div>

  <div class="flex flex-col gap-2">
    <label for="details" class="font-mono text-sm opacity-80 text-mocha-mauve">Project Details</label>
    <textarea
      id="details"
      name="details"
      required
      minlength="20"
      rows="5"
      placeholder="Briefly describe the project's objective, key features, and expectations..."
      class="bg-mocha-crust border border-mocha-surface-0 rounded-lg p-3 text-mocha-text focus:outline-none focus:border-mocha-mauve transition-colors resize-none"
    ></textarea>
  </div>

  <button
    type="submit"
    class="mt-4 bg-mocha-surface-0 text-mocha-text font-mono font-bold text-lg py-3 px-6 rounded-lg hover:bg-mocha-green hover:text-mocha-crust hover:border-transparent border border-mocha-text/20 transition-all cursor-pointer"
  >
    [ Submit Request ]
  </button>
</form>