---
const { id, label, color, hoverColor, isActive = false } = Astro.props;
---
<button
  data-switcher={id}
  data-color={color}
  data-hover-color={`hover:${hoverColor}`}
  class:list={[
    "px-4 py-2 rounded-full transition-all border cursor-pointer w-full md:w-auto",
    {
      [`${color} text-catp-crust font-bold border-transparent`]: isActive,
      [`bg-transparent text-catp-subtext-0 border-catp-overlay-0 hover:text-catp-text hover:${hoverColor}`]:
        !isActive,
    },
  ]}
>
  {label}
</button>