---
const { href, class: className, showActive = false, ...props } = Astro.props;
const currentPath = Astro.url.pathname;
const isActive =
  href === "/"
    ? currentPath === "/"
    : currentPath === href || currentPath.startsWith(`${href}/`);
---

<a
  href={href}
  aria-current={isActive && showActive ? "page" : undefined}
  class:list={[
    "transition-colors hover:text-catp-blue w-fit",
    { "text-catp-blue": isActive && showActive },
    className,
  ]}
  {...props}
>
  <slot />
</a>