---
const { href, class: className, showActive = false, ...props } = Astro.props;
const currentPath = Astro.url.pathname;
---

<a
  href={href}
  class:list={[
    "transition-colors hover:text-mocha-blue",
    { "text-mocha-blue": currentPath.includes(href) && showActive },
    className,
  ]}
  {...props}
>
  <slot />
</a>
