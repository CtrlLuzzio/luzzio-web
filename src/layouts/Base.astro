---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

import { Font } from "astro:assets";
const { pageTitle } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-mono" />
    <title>Luzzio - {pageTitle}</title>
  </head>
  <body class="flex flex-col min-h-screen">
    <div
      class="fixed inset-0 -z-10 pointer-events-none opacity-10"
      style="background-image: url('/bg.svg'); background-size: cover; background-position: center;"
    ></div>
    <Header />
    <main class="flex-1 px-4 md:px-20 pb-16 relative">
      <slot />
    </main>
    <Footer />
  </body>
</html>