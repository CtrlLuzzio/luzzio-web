---
import BaseLayout from "../../layouts/Base.astro";
import Pagination from "../../components/Pagination.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import type { PaginateFunction, Page } from "astro";

interface BlogPostLink {
  id: string;
  title: string;
}

interface ProjectItem {
  name: string;
  description: string | null;
  isPrivate: boolean;
  htmlUrl: string;
  language: string | null;
  topics: string[];
  updatedAt: string;
  readmeHtml: string | null;
  blogPosts: BlogPostLink[];
}

interface GitHubRepoResponse {
  name: string;
  description: string | null;
  private: boolean;
  html_url: string;
  language: string | null;
  topics?: string[];
  pushed_at: string;
  fork: boolean;
}

interface Props {
  page: Page<ProjectItem>;
}

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const TOKEN = import.meta.env.GITHUB_TOKEN;
  const USERNAME = import.meta.env.GITHUB_USERNAME;
  const REQUIRED_TOPIC = "portfolio";
  const allPosts = await getCollection("blog");
  const blogMap: Record<string, BlogPostLink[]> = {};

  for (const post of allPosts) {
    const repoKey = post.data.projectRepo?.toLowerCase();
    if (repoKey) {
      if (!blogMap[repoKey]) blogMap[repoKey] = [];
      blogMap[repoKey].push({
        id: post.id,
        title: post.data.title,
      });
    }
  }

  let projects: ProjectItem[] = [];

  if (!TOKEN) {
    console.error("Falta GITHUB_TOKEN en .env para consultar repositorios.");
    return paginate(projects, { pageSize: 6 });
  }

  const baseHeaders = {
    Authorization: `Bearer ${TOKEN}`,
    "X-GitHub-Api-Version": "2022-11-28",
  };

  try {
    const reposRes = await fetch(
      "https://api.github.com/user/repos?visibility=all&affiliation=owner&sort=pushed&per_page=100",
      {
        headers: {
          ...baseHeaders,
          Accept: "application/vnd.github+json",
        },
      }
    );

    if (!reposRes.ok) {
      throw new Error(`GitHub Repos API error (${reposRes.status}): ${await reposRes.text()}`);
    }

    const rawRepos = (await reposRes.json()) as GitHubRepoResponse[];

    const filteredRepos = rawRepos.filter(
      (repo) => !repo.fork && repo.topics?.includes(REQUIRED_TOPIC)
    );

    projects = await Promise.all(
      filteredRepos.map(async (repo) => {
        let readmeHtml: string | null = null;

        try {
          const readmeRes = await fetch(
            `https://api.github.com/repos/${USERNAME}/${repo.name}/readme`,
            {
              headers: {
                ...baseHeaders,
                Accept: "application/vnd.github.html+json",
              },
            }
          );

          if (readmeRes.ok) {
            readmeHtml = await readmeRes.text();
          }
        } catch (err) {
          console.error(`Error obteniendo README de ${repo.name}:`, err);
        }

        const updatedDate = new Date(repo.pushed_at).toLocaleDateString("en-US", {
          year: "numeric",
          month: "short",
          day: "numeric",
        });

        return {
          name: repo.name,
          description: repo.description,
          isPrivate: repo.private,
          htmlUrl: repo.html_url,
          language: repo.language,
          topics: (repo.topics || []).filter((t) => t !== REQUIRED_TOPIC),
          updatedAt: updatedDate,
          readmeHtml,
          blogPosts: blogMap[repo.name.toLowerCase()] || [],
        };
      })
    );
  } catch (error) {
    console.error("Error en el fetch a GitHub:", error);
  }

  return paginate(projects, { pageSize: 6 });
}

const { page } = Astro.props;
const pageTitle = `Projects ${page.currentPage > 1 ? `- Page ${page.currentPage}` : ""}`;
---

<BaseLayout pageTitle={pageTitle}>
  <section class="flex flex-col items-start gap-6 max-w-3xl py-12 md:py-20 mb-4">
    <h1 class="text-4xl md:text-6xl font-mono font-bold text-catp-mauve">Projects</h1>
    <p class="text-lg md:text-xl text-catp-subtext-1">
      A curated selection of my open-source repositories and private architectures, pulled directly from GitHub.
    </p>
  </section>

  <section class="bg-catp-surface-0 p-8 md:p-12 rounded-3xl shadow-xl shadow-catp-shadow/20 mb-20">
    <div class="flex flex-col gap-6">
      {page.data.length === 0 ? (
        <div class="p-6 rounded-2xl bg-catp-base border-2 border-catp-surface-2 text-center">
          <p class="text-catp-subtext-0 font-mono">No projects found or connection error.</p>
        </div>
      ) : (
        page.data.map((project: ProjectItem) => (
          <article
            id={`project-${project.name.toLowerCase()}`}
            class:list={[
              "scroll-mt-28 flex flex-col gap-6 p-6 md:p-8 rounded-2xl bg-catp-base border-2 border-transparent target:border-catp-teal transition-all w-full",
              { "hover:border-catp-surface-2": !project.isPrivate },
            ]}
          >
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
              <div class="flex flex-col gap-1">
                <div class="flex flex-wrap items-center gap-3">
                  {project.isPrivate ? (
                    <div class="flex items-center gap-2.5 text-2xl md:text-3xl font-mono font-bold text-catp-text">
                      <Icon name="tabler:lock" class="w-7 h-7 text-catp-red shrink-0" />
                      <span>{project.name}</span>
                      <span class="text-xs font-mono px-2.5 py-0.5 rounded-full bg-catp-crust text-catp-subtext-0 border border-catp-surface-0">
                        Private
                      </span>
                    </div>
                  ) : (
                    <a
                      href={project.htmlUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="w-fit flex items-center gap-2.5 text-2xl md:text-3xl font-mono font-bold text-catp-text hover:text-catp-blue transition-colors group"
                    >
                      <Icon name="tabler:brand-github" class="w-7 h-7 text-catp-teal shrink-0" />
                      <span>{project.name}</span>
                      <Icon
                        name="tabler:external-link"
                        class="w-5 h-5 opacity-50 group-hover:opacity-100 transition-opacity"
                      />
                    </a>
                  )}
                </div>

                {project.description && (
                  <p class="text-catp-subtext-1 text-base md:text-lg mt-1">
                    {project.description}
                  </p>
                )}
              </div>

              <div class="flex flex-wrap items-center gap-2 self-start md:self-center shrink-0">
                {project.language && (
                  <span class="px-3 py-1 bg-catp-crust text-catp-green font-mono text-xs font-bold rounded-full border border-catp-surface-0">
                    {project.language}
                  </span>
                )}
                <span class="font-mono text-xs text-catp-subtext-0">
                  Updated {project.updatedAt}
                </span>
              </div>
            </div>

            {project.readmeHtml && (
              <div class="bg-catp-crust rounded-xl border border-catp-surface-0 p-5 md:p-6 flex flex-col">
                <div class="readme-wrapper relative max-h-56 overflow-hidden transition-all duration-300">
                  <div class="prose-catp text-base" set:html={project.readmeHtml} />
                  <div class="readme-fade absolute bottom-0 inset-x-0 h-20 bg-linear-to-t from-catp-crust to-transparent pointer-events-none hidden" />
                </div>

                <button
                  type="button"
                  aria-expanded="false"
                  class="readme-toggle-btn hidden mt-4 pt-3 border-t border-catp-surface-0 font-mono text-sm font-bold text-catp-teal hover:text-catp-mauve transition-colors items-center gap-2 cursor-pointer w-fit"
                >
                  <span class="readme-toggle-text">Read more</span>
                  <Icon name="tabler:chevron-down" class="readme-toggle-icon w-4 h-4 transition-transform duration-300" />
                </button>
              </div>
            )}

            {project.blogPosts.length > 0 && (
              <div class="flex flex-wrap items-center gap-3 pt-2 border-t border-catp-surface-0">
                <span class="text-catp-subtext-0 font-mono text-sm flex items-center gap-1.5">
                  <Icon name="tabler:file-text" class="w-4 h-4 text-catp-mauve" />
                  Related Posts:
                </span>
                {project.blogPosts.map((post) => (
                  <a
                    href={`/blog/${post.id}`}
                    class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-catp-surface-0 hover:bg-catp-surface-1 text-catp-text font-mono text-sm rounded-lg transition-colors border border-catp-surface-2"
                  >
                    <span>{post.title}</span>
                  </a>
                ))}
              </div>
            )}
          </article>
        ))
      )}
    </div>

    <Pagination page={page} />
  </section>
</BaseLayout>

<script src="../../scripts/projects.ts"></script>