---
import BaseLayout from "../layouts/Base.astro";
import PersonaSwitcherContent from "../components/PersonaSwitcherContent.astro";
import PersonaSwitcherButton from "../components/PersonaSwitcherButton.astro";
import Link from "../components/Link.astro";
import HeroActions from "../components/HeroActions.astro";
import SectionCard from "../components/SectionCard.astro";
import TwitchBento from "../components/TwitchBento.astro";
import BentoBox from "../components/BentoBox.astro";
import { Icon } from "astro-icon/components";
import { getCollection, type CollectionEntry } from "astro:content";

type PostCard = {
  title: string;
  desc: string;
  icon: string;
  color: string;
  url: string;
};

const allPosts = await getCollection("blog");
const latestPosts: PostCard[] = allPosts
  .sort(
    (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  )
  .map((post: CollectionEntry<"blog">) => ({
    title: post.data.title,
    desc: post.data.desc,
    icon: post.data.icon,
    color: post.data.color,
    url: `/blog/${post.id}`,
  }));

const pageTitle = "Home";
---

<BaseLayout pageTitle={pageTitle}>
  <section
    id="hero"
    class="flex flex-col md:flex-row items-center justify-between min-h-[75vh] py-24 px-16 md:py-32 md:px-20 mb-12 gap-12"
  >
    <div class="flex flex-col items-start text-left gap-6 max-w-2xl w-full">
      <h2 class="text-5xl md:text-7xl font-mono font-bold text-mocha-mauve">
        Luzzio
      </h2>

      <div class="flex flex-wrap gap-3 font-mono text-sm md:text-base mb-2">
        <PersonaSwitcherButton
          id="dev"
          label="Full-Stack Developer"
          color="bg-mocha-green"
          isActive={true}
        />
        <PersonaSwitcherButton
          id="fgc"
          label="FGC Competitor"
          color="bg-mocha-red"
        />
        <PersonaSwitcherButton
          id="creator"
          label="Content Creator"
          color="bg-mocha-blue"
        />
      </div>
      <div class="grid [grid-template-areas:'stack'] w-full min-h-36">
        <!-- DEV -->
        <PersonaSwitcherContent id="dev" isActive={true}>
          <div class="flex flex-col gap-6">
            <p class="text-lg">
              Specializing in UI/UX design & web development, but capable of
              anything. Always looking for the optimal architectural route.
            </p>
            <HeroActions
              href="/services"
              label="View Services"
              colorClass="bg-mocha-green"
            />
          </div>
        </PersonaSwitcherContent>

        <!-- FGC -->
        <PersonaSwitcherContent id="fgc">
          <div class="flex flex-col gap-6">
            <p class="text-lg">
              Competitive fighting game player. Maining Juri in SF6 and Robo Ky
              in GGST. Always looking for the optimal combo route.
            </p>
            <HeroActions
              href="https://start.gg/"
              label="View Results"
              colorClass="bg-mocha-red"
              isExternal={true}
            />
          </div>
        </PersonaSwitcherContent>

        <!-- CREATOR -->
        <PersonaSwitcherContent id="creator">
          <div class="flex flex-col gap-6">
            <p class="text-lg">
              Live streaming high-level gameplay, tournament brackets, and more.
              Always looking for the optimal route to throw for content.
            </p>
            <HeroActions
              href="https://www.twitch.tv/luzzio__"
              label="Watch Live"
              colorClass="bg-mocha-blue"
              isExternal={true}
            />
          </div>
        </PersonaSwitcherContent>
      </div>
    </div>

    <div class="shrink-0">
      <div
        class="w-48 h-48 md:w-64 md:h-64 rounded-full border-4 border-mocha-surface-0 bg-mocha-crust overflow-hidden flex justify-center items-center shadow-lg shadow-mocha-crust/50"
      >
        <!-- PLACEHOLDER -->
        <span class="font-mono text-mocha-surface-0 font-bold text-2xl">
          AVATAR
        </span>
        <!--
        <img src="/avatar.webp" alt="Luzzio Avatar" class="w-full h-full object-cover" />
        -->
      </div>
    </div>
  </section>

  <SectionCard id="about" title="About Me">
    <div class="w-full">
      <!-- DEV Text -->
      <PersonaSwitcherContent id="dev" isActive={true}>
        <div class="text-lg flex flex-col gap-4">
          <p>
            I'm a Computer Informatics Engineering student at UCLA (Universidad
            Centroccidental Lisandro Alvarado, not the University of California)
            and a full-stack developer. My professional experience is heavily
            rooted in enterprise software architecture, specifically developing
            custom Odoo ERP modules, handling containerized deployments with
            Docker and Podman, and managing databases using Python, JavaScript,
            and PostgreSQL.
          </p>
          <p>
            Beyond enterprise systems, I also enjoy building modern, fast web
            applications and static sites (like this very portfolio) using
            Astro, React, and Tailwind CSS, or writing automation scripts with
            Bash, Lua, and Python. Whether I'm writing complex backend endpoints
            or designing a frontend component, I always aim for the perfect
            balance between robust logic and a seamless UI/UX.
          </p>
          <p>
            Ironically for a web developer, I spend most of my time in the
            terminal. I'm a huge Linux enthusiast, currently daily driving
            openSUSE Tumbleweed for work and NixOS with Hyprland for my personal
            setup. Tinkering with my system and optimizing my workflow is
            practically a second job for me (feel free to check my
            <Link
              href="https://github.com/CtrlLuzzio/dotfiles"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:underline"
            >
              <code
                class="font-mono text-mocha-green bg-mocha-base px-1.5 py-0.5 rounded text-sm"
              >
                dotfiles
              </code>
            </Link>
            and
            <Link
              href="https://github.com/CtrlLuzzio/nixos-dotfiles"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:underline"
            >
              <code
                class="font-mono text-mocha-green bg-mocha-base px-1.5 py-0.5 rounded text-sm"
              >
                nixos-dotfiles
              </code>
            </Link>
            repos).
          </p>
          <p class="font-mono text-mocha-green mt-4 opacity-100">
            &gt; Check some of the stuff I make:
          </p>
        </div>
      </PersonaSwitcherContent>
      <!-- FGC Text -->
      <PersonaSwitcherContent id="fgc">
        <div class="text-lg flex flex-col gap-4">
          <p>
            I've been competing in fighting games since 2022, back when I used
            to play Super Smash Bros. Ultimate.
          </p>
          <p>
            I made the jump to "classic" fighting games around 2024 with Guilty
            Gear XX Accent Core +R, maining A.B.A, since the PC I had then
            wasn't able to run Strive. I started playing Strive seriously when a
            friend lent me his PS4 to play the game (thank you ApE <span
              class="text-mocha-red">&lt;3</span
            >).
          </p>
          <p>
            A few months after that, I finally built a PC capable of running
            modern games properly. That was the real turning point: for the
            first time, I could actually lab and grind comfortably from home.
            That newfound consistency paid off, as I arguably became the best
            A.B.A in the country throughout Season 3 and part of Season 4 of
            Strive.
          </p>
          <p>
            Eventually, I made the jump to Street Fighter 6, which is my main
            focus today. Picking up Juri, I’ve managed to put up solid
            tournament results and keep pushing my neutral and execution even
            further—though I still play Strive sometimes with Robo-Ky as my
            current main (things happened with A.B.A, but the love is still
            there).
          </p>
          <p class="font-mono text-mocha-red mt-4">&gt; See me in bracket:</p>
        </div>
      </PersonaSwitcherContent>

      <!-- CREATOR Text -->
      <PersonaSwitcherContent id="creator">
        <div class="text-lg flex flex-col gap-4">
          <p>
            Content creation is where my love for gaming and technical skills
            meet. Fighting games are the undeniable heart of my streams. Most
            days I'm locked in either labbing tech in training mode, grinding
            ranked matches, or playing casual sets against viewers. However, to
            keep things fresh, I like mixing things up with variety games like
            Balatro, Minecraft, or whatever game I feel like playing that day.
          </p>
          <p>
            My goal is to build a welcoming, engaging space for everyone who
            drops by. I'm constantly working on improving my content, whether
            that means upgrading my stream assets or editing better VODs and
            highlights.
          </p>
          <p>
            Behind the scenes, I handle the entire production pipeline. From
            setting up dynamic OBS overlays to editing VODs, stream highlights,
            and designing thumbnails, I treat my channels as an ongoing project
            to continuously improve.
          </p>
          <p>
            At the end of the day, it's all about the community. Whether I'm
            sweating in a grand finals set or talking about which character in
            SF6 makes the best arepas, I'm here to share the moment and have a
            great time with the chat.
          </p>
          <p class="font-mono text-mocha-blue mt-4 opacity-100">
            &gt; Get into the broadcast:
          </p>
        </div>
      </PersonaSwitcherContent>
    </div>

    <div class="w-full">
      <!-- DEV Bento Grid -->
      <PersonaSwitcherContent id="dev" isActive={true}>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 auto-rows-min w-full">
          <BentoBox
            href="/projects"
            class="hover:border-mocha-teal"
            icon="tabler:terminal"
            title="Dev Projects"
            iconColor="text-mocha-teal"
          >
            See some of the best projects I've built (both open and closed
            source!).
          </BentoBox>
          <BentoBox
            href="/services"
            class="hover:border-mocha-green"
            icon="tabler:code"
            title="Services"
            iconColor="text-mocha-green"
          >
            Need a custom solution? Let's talk!
          </BentoBox>
        </div>
      </PersonaSwitcherContent>

      <!-- FGC Bento Grid -->
      <PersonaSwitcherContent id="fgc">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 auto-rows-min w-full">
          <!-- Placeholder Link -->
          <BentoBox
            href="https://start.gg/"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:border-mocha-red"
            icon="tabler:trophy"
            title="Tournament Results"
            iconColor="text-mocha-red"
          >
            Watch my tournament results (pulled from start.gg).
          </BentoBox>
          <TwitchBento />
        </div>
      </PersonaSwitcherContent>

      <!-- CREATOR Bento Grid -->
      <PersonaSwitcherContent id="creator">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 auto-rows-min w-full">
          <TwitchBento class="md:col-span-2" />
          <BentoBox
            href="https://www.youtube.com/@soyluzzio"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:border-mocha-red"
            icon="tabler:brand-youtube"
            title="YouTube"
            iconColor="text-mocha-red"
          >
            VODs, stream highlights, and longer form content.
          </BentoBox>
          <BentoBox
            href="https://www.tiktok.com/@luzzio__"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:border-mocha-pink"
            icon="tabler:brand-tiktok"
            title="Tiktok"
            iconColor="text-mocha-pink"
          >
            Short clips and stream's best (and worst) moments.
          </BentoBox>
        </div>
      </PersonaSwitcherContent>
    </div>
  </SectionCard>
  <SectionCard id="blog" title="Blog">
    <div
      class="flex flex-col md:flex-row md:items-center justify-between gap-6"
    >
      <p class="text-lg flex-1">
        Here I talk about tech guides, dev logs, personal anecdotes, and
        anything that comes to mind.
      </p>
      <div class="flex gap-3 shrink-0">
        <button
          id="blog-prev"
          class="p-3 rounded-full border border-mocha-surface-2 hover:border-mocha-overlay-0 transition-colors text-mocha-text bg-mocha-base cursor-pointer"
          aria-label="Previous"
        >
          <Icon name="tabler:arrow-left" class="w-6 h-6" />
        </button>
        <button
          id="blog-next"
          class="p-3 rounded-full border border-mocha-surface-2 hover:border-mocha-overlay-0 transition-colors text-mocha-text bg-mocha-base cursor-pointer"
          aria-label="Next"
        >
          <Icon name="tabler:arrow-right" class="w-6 h-6" />
        </button>
      </div>
    </div>
    <div
      id="blog-track"
      class="flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-4 scrollbar-none -ms-overflow-style:none &::-webkit-scrollbar:hidden"
    >
      {
        latestPosts.slice(0, 5).map((post: PostCard, index: number) => (
          <BentoBox
            href={post.url}
            class:list={[
              "w-full md:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)] shrink-0 snap-start bg-mocha-base hover:border-mocha-surface-2 h-auto",
              {
                "hidden md:flex": index >= 3,
                "md:hidden lg:flex": index === 4,
              },
            ]}
            icon={post.icon}
            title={post.title}
            iconColor={post.color}
          >
            {post.desc}
          </BentoBox>
        ))
      }

      <a
        href="/blog"
        class="flex flex-col items-center justify-center gap-4 p-8 rounded-2xl bg-mocha-base border-2 border-dashed border-mocha-surface-2 hover:border-mocha-mauve hover:text-mocha-mauve transition-colors group text-center w-full md:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)] shrink-0 snap-start h-auto min-h-62.5"
      >
        <Icon
          name="tabler:arrow-right"
          class="w-12 h-12 text-mocha-surface-2 group-hover:text-mocha-mauve transition-colors"
        />
        <div>
          <h3 class="text-2xl font-mono font-bold">View All</h3>
          <p class="opacity-70 mt-2 text-mocha-text">
            Explore the rest of the articles
          </p>
        </div>
      </a>
    </div>
  </SectionCard>
</BaseLayout>
<script>
  import { actions } from "astro:actions";

  function initPersonaSwitcher() {
    const buttons = document.querySelectorAll("[data-switcher]");
    const contents = document.querySelectorAll("[data-persona]");

    if (!buttons.length) return;

    const colorMap = {
      dev: "bg-mocha-green",
      fgc: "bg-mocha-red",
      creator: "bg-mocha-blue",
    };

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = btn.getAttribute("data-switcher");
        if (!target) return;

        const activeColor = colorMap[target as keyof typeof colorMap];

        buttons.forEach((b) => {
          b.classList.remove(
            "bg-mocha-green",
            "bg-mocha-red",
            "bg-mocha-blue",
            "text-mocha-crust",
            "font-bold",
          );
          b.classList.add(
            "bg-transparent",
            "text-mocha-text",
            "opacity-70",
            "border-transparent",
            "hover:border-mocha-overlay-0",
          );
        });

        btn.classList.remove(
          "bg-transparent",
          "text-mocha-text",
          "opacity-70",
          "border-transparent",
          "hover:border-mocha-overlay-0",
        );
        btn.classList.add(
          activeColor,
          "text-mocha-crust",
          "font-bold",
          "border-transparent",
        );

        contents.forEach((content) => {
          if (content.getAttribute("data-persona") === target) {
            content.classList.remove("hidden");
            content.classList.add("block", "animate-fade-in");
          } else {
            content.classList.add("hidden");
            content.classList.remove("block", "animate-fade-in");
          }
        });
      });
    });
  }

  async function checkTwitchStatus() {
    const badgeContainers = document.querySelectorAll(".twitch-status-badge");
    const statusDots = document.querySelectorAll(".twitch-status-dot");
    const statusTexts = document.querySelectorAll(".twitch-status-text");

    if (!badgeContainers.length) return;

    try {
      const { data, error } = await actions.twitch.getTwitchStatus();

      if (!error && data?.isLive) {
        badgeContainers.forEach((badge) => {
          badge.classList.replace("bg-mocha-crust", "bg-mocha-red/10");
          badge.classList.replace(
            "border-mocha-surface-0",
            "border-mocha-red/50",
          );
        });

        statusDots.forEach((dot) => {
          dot.classList.replace("bg-mocha-text", "bg-mocha-red");
          dot.classList.remove("opacity-50");
          dot.classList.add("animate-pulse");
        });

        statusTexts.forEach((text) => {
          text.classList.replace("text-mocha-text", "text-mocha-red");
          text.textContent = "Live";
        });
      }
    } catch (e) {
      console.error("Unable to get twitch status");
    }
  }
  function initBlogSlider() {
    const track = document.getElementById("blog-track");
    const prevBtn = document.getElementById("blog-prev");
    const nextBtn = document.getElementById("blog-next");

    if (!track || !prevBtn || !nextBtn) return;

    const scrollByItem = (direction: "prev" | "next") => {
      const firstVisibleItem = track.querySelector("a:not(.hidden)");
      if (!firstVisibleItem) return;

      const itemWidth = firstVisibleItem.getBoundingClientRect().width;
      const gap = parseFloat(getComputedStyle(track).gap) || 0;
      const scrollAmount = itemWidth + gap;

      track.scrollBy({
        left: direction === "next" ? scrollAmount : -scrollAmount,
        behavior: "smooth",
      });
    };

    prevBtn.addEventListener("click", () => scrollByItem("prev"));
    nextBtn.addEventListener("click", () => scrollByItem("next"));
  }

  initPersonaSwitcher();
  checkTwitchStatus();
  initBlogSlider();
</script>
