---
import BaseLayout from "../layouts/Base.astro";
import { Icon } from "astro-icon/components";

const pageTitle = "Home";
---

<BaseLayout pageTitle={pageTitle}>
  <section
    class="flex flex-col md:flex-row items-center justify-between min-h-100 py-16 mb-12 border-b-2 border-mocha-surface-0 gap-12"
  >
    <div class="flex flex-col items-start text-left gap-6 max-w-2xl">
      <h2 class="text-5xl md:text-7xl font-mono font-bold text-mocha-mauve">
        Luzzio
      </h2>
      <p class="text-xl md:text-2xl opacity-90">
        Full-Stack Developer | FGC Competitor | Content Creator
      </p>
      <p class="text-lg opacity-75 text-pretty">
        Specializing in UI/UX design & web development. Passionate about Linux
        and videogames. Always looking for the optimal route.
      </p>
    </div>

    <div class="shrink-0">
      <div
        class="w-48 h-48 md:w-64 md:h-64 rounded-full border-4 border-mocha-surface-0 bg-mocha-crust flex justify-center items-center shadow-lg shadow-mocha-crust/50"
      >
        <!-- PLACEHOLDER -->
        <span class="font-mono text-mocha-surface-0 font-bold text-2xl"
          >AVATAR</span
        >
        <!--
        <img src="/avatar.webp" alt="Luzzio Avatar" class="w-full h-full object-cover" />
        -->
      </div>
    </div>
  </section>

  <section
    class="flex flex-col gap-6 py-12 mb-12 border-b-2 border-mocha-surface-0"
  >
    <div class="flex items-center gap-4 mb-2">
      <h3 class="text-3xl font-mono font-bold text-mocha-mauve">About Me</h3>
    </div>
    <div class="text-lg opacity-85 flex flex-col gap-4 text-mocha-text">
      <p>
        I'm a 22yo Computer Engineering student at UCLA (Venezuela) and a full-stack
        developer with hands-on experience in enterprise software architecture,
        custom ERP module implementation, and UI/UX design. When developing, I
        always strive (pun intended) for the perfect balance between a solid
        backend and a seamless user experience.
      </p>
      <p>
        Ironically, I'm more of a terminal person; I enjoy tinkering and
        customizing my dotfiles for my Linux environment (see my <code
          class="font-mono text-mocha-green bg-mocha-surface-0 px-1 rounded text-sm"
          >dotfiles</code
        > and <code
          class="font-mono text-mocha-green bg-mocha-surface-0 px-1 rounded text-sm"
          >nixos-dotfiles</code
        > repos).
      </p>
      <p>
        Outside the dev environment, I'm an active member of the Fighting Game
        Community (FGC). I regularly compete in whatever game I'm playing at the
        moment (currently Street Fighter 6 and sometimes Guilty Gear Strive),
        and I dedicate part of my time to organizing local tournaments to help
        grow the competitive scene.
      </p>
      <p>
        I also stream ranked sessions and variety games, always down for a good
        chat interaction (and the not so occasional throw for content).
      </p>
    </div>
  </section>

  <!-- Placeholders/Testing, not sure if implementing them at the end lol -->

  <section>
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-min"
    >
      <a
        href="/portfolio"
        class="flex flex-col gap-4 p-8 rounded-2xl bg-mocha-surface-0 border-2 border-transparent hover:border-mocha-green transition-colors md:col-span-2"
      >
        <div class="flex items-center gap-3">
          <Icon name="simple-icons:devdotto" class="w-8 h-8 text-mocha-green" />
          <h3 class="text-2xl font-mono font-bold text-mocha-green">Web Dev</h3>
        </div>
        <p class="opacity-80 flex-1">Lorem Ipsum Dolor & Cheddar</p>
        <span class="font-bold font-mono text-sm mt-auto"
          >[ See Portafolio -&gt; ]</span
        >
      </a>

      <a
        href="/blog"
        class="flex flex-col gap-4 p-8 rounded-2xl bg-mocha-surface-0 border-2 border-transparent hover:border-mocha-green transition-colors"
      >
        <div class="flex items-center gap-3">
          <Icon
            name="simple-icons:gnometerminal"
            class="w-7 h-7 text-mocha-green"
          />
          <h3 class="text-2xl font-mono font-bold text-mocha-green">Blog</h3>
        </div>
        <p class="opacity-80 flex-1">Lorem Ipsum Dolor & Cheddar</p>
        <span class="font-bold font-mono text-sm mt-auto"
          >[ See More -&gt; ]</span
        >
      </a>

      <a
        href="https://www.twitch.tv/luzzio__"
        target="_blank"
        rel="noopener noreferrer"
        class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 p-8 rounded-2xl bg-mocha-surface-0 border-2 border-transparent hover:border-[#9146FF] transition-colors md:col-span-2 lg:col-span-3"
      >
        <div class="flex flex-col gap-4">
          <div class="flex items-center gap-3">
            <Icon name="simple-icons:twitch" class="w-8 h-8 text-[#9146FF]" />
            <h3 class="text-2xl font-mono font-bold">Sick Gamer Skills</h3>
          </div>
          <p class="opacity-80 max-w-2xl">Lorem Ipsum Dolor & Cheddar</p>
        </div>

        <div
          class="flex items-center gap-3 px-5 py-3 bg-mocha-base rounded-full border border-mocha-surface-0 shrink-0"
        >
          <span class="w-3 h-3 rounded-full bg-mocha-text opacity-50"></span>
          <span class="font-mono font-bold text-sm">Offline</span>
        </div>
      </a>
    </div>
  </section>
</BaseLayout>