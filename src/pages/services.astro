---
import BaseLayout from "../layouts/Base.astro";
import BentoBox from "../components/BentoBox.astro";
import LeadForm from "../components/LeadForm.astro";

const pageTitle = "Services";
---

<BaseLayout pageTitle={pageTitle}>
  <section class="flex flex-col items-start gap-6 max-w-3xl py-12 md:py-20">
    <h2 class="text-4xl md:text-6xl font-mono font-bold text-catp-mauve">
      Services
    </h2>
    <p class="text-lg md:text-xl text-catp-subtext-1">
      Custom software development. Explore the areas of specialization and
      request a technical proposal.
    </p>
  </section>

  <section
    class="bg-catp-surface-0 p-8 md:p-12 rounded-3xl shadow-xl shadow-catp-crust/20 mb-20"
  >
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-min"
    >
      <BentoBox
        href="#quote"
        class="hover:border-catp-blue bg-catp-base"
        icon="tabler:layout"
        title="Static Website"
        iconColor="text-catp-blue"
      >
        Perfect for portfolios, campaigns and many more.
      </BentoBox>

      <BentoBox
        href="#quote"
        class="hover:border-catp-green bg-catp-base"
        icon="tabler:code"
        title="Web App"
        iconColor="text-catp-green"
      >
        Dynamic platforms with databases, authentication and complex logic.
      </BentoBox>
      <BentoBox
        href="#quote"
        class="hover:border-catp-mauve bg-catp-base"
        icon="tabler:database"
        title="Custom Odoo Module"
        iconColor="text-catp-mauve"
      >
        Custom Odoo module development to adapt the ERP to your company.
      </BentoBox>

      <BentoBox
        href="#quote"
        class="hover:border-catp-yellow bg-catp-base"
        icon="tabler:server"
        title="DevOps & Servers"
        iconColor="text-catp-yellow"
      >
        Linux environment configutarion, containers and VPS deployments to
        existing projects
      </BentoBox>

      <BentoBox
        href="#quote"
        class="hover:border-catp-red bg-catp-base"
        icon="tabler:device-gamepad"
        title="Creator Tools"
        iconColor="text-catp-red"
      >
        Dynamic overlays, bots and API integrations for your streams.
      </BentoBox>
      <BentoBox
        href="#quote"
        class="hover:border-catp-teal bg-catp-base"
        icon="tabler:tool"
        title="Custom Request"
        iconColor="text-catp-teal"
      >
        Do you have something else in mind? Describe your needs in the quotation
        and I'll see if I can make it happen.
      </BentoBox>
    </div>
  </section>

  <section
    id="quote"
    class="flex flex-col gap-8 max-w-4xl mx-auto w-full mb-12 scroll-mt-24"
  >
    <div class="flex flex-col gap-4">
      <div class="flex items-center gap-4">
        <h3 class="text-3xl font-mono font-bold text-catp-teal">
          Get a quote for your project
        </h3>
        <div class="h-0.5 flex-1 bg-catp-base opacity-50"></div>
      </div>
      <p class="text-catp-subtext-1 text-lg">
        Fill the form to evaluate the technical requirements and the initial
        scope of the project.
      </p>
    </div>

    <LeadForm />
  </section>
</BaseLayout>
