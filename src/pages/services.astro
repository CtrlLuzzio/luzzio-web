---
import BaseLayout from "../layouts/Base.astro";
import BentoBox from "../components/BentoBox.astro";
import LeadForm from "../components/LeadForm.astro";

const pageTitle = "Services";
---

<BaseLayout pageTitle={pageTitle}>
  <section class="flex flex-col items-start gap-6 max-w-3xl py-12 md:py-20">
    <h2 class="text-4xl md:text-6xl font-mono font-bold text-mocha-mauve">
      Services
    </h2>
    <p class="text-lg md:text-xl opacity-80">
      Custom software development. Explore the areas of specialization and
      request a technical proposal.
    </p>
  </section>

  <section
    class="bg-mocha-surface-0 p-8 md:p-12 rounded-3xl shadow-xl shadow-mocha-crust/20 mb-20"
  >
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-min"
    >
      <BentoBox
        href="#quote"
        class="hover:border-mocha-blue bg-mocha-base"
        icon="tabler:layout"
        title="Static Website"
        iconColor="text-mocha-blue"
      >
        Perfect for portfolios, campaigns and many more.
      </BentoBox>

      <BentoBox
        href="#quote"
        class="hover:border-mocha-green bg-mocha-base"
        icon="tabler:code"
        title="Web App"
        iconColor="text-mocha-green"
      >
        Dynamic platform with databases, auth and complex logic.
      </BentoBox>
      <BentoBox
        href="#quote"
        class="hover:border-mocha-mauve bg-mocha-base"
        icon="tabler:database"
        title="Custom Odoo Module"
        iconColor="text-mocha-mauve"
      >
        Custom Odoo module development to adapt the ERP to your company.
      </BentoBox>

      <BentoBox
        href="#quote"
        class="hover:border-mocha-pink bg-mocha-base"
        icon="tabler:brush"
        title="UI/UX Website Audit"
        iconColor="text-mocha-pink"
      >
        Figma prototyping, wireframing and redesign focused on usability and web
        accesibility.
      </BentoBox>

      <BentoBox
        href="#quote"
        class="hover:border-mocha-yellow bg-mocha-base"
        icon="tabler:server"
        title="DevOps & Servers"
        iconColor="text-mocha-yellow"
      >
        Linux environment configutarion, containers and VPS deployments to
        existing projects
      </BentoBox>

      <BentoBox
        href="#quote"
        class="hover:border-mocha-red bg-mocha-base"
        icon="tabler:device-gamepad"
        title="Creator Tools"
        iconColor="text-mocha-red"
      >
        Dynamic overlays, bots and API integrations for your streams.
      </BentoBox>
      <BentoBox
        href="#quote"
        class="hover:border-mocha-teal bg-mocha-base md:col-span-2 lg:col-span-3"
        icon="tabler:tool"
        title="Custom Request"
        iconColor="text-mocha-teal"
      >
        Do you have something different in mind? Describe your needs in the
        quotation and I'll see if I can make it happen.
      </BentoBox>
    </div>
  </section>

  <section
    id="quote"
    class="flex flex-col gap-8 max-w-4xl mx-auto w-full mb-12 scroll-mt-24"
  >
    <div class="flex flex-col gap-4">
      <div class="flex items-center gap-4">
        <h3 class="text-3xl font-mono font-bold text-mocha-teal">
          Get a quote for your project
        </h3>
        <div class="h-0.5 flex-1 bg-mocha-base opacity-50"></div>
      </div>
      <p class="opacity-70 text-lg">
        Fill the form to evaluate the technical requirements and the initial
        scope of the project.
      </p>
    </div>

    <LeadForm />
  </section>
</BaseLayout>
