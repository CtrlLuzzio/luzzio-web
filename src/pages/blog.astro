---
import BaseLayout from "../layouts/Base.astro";
import BentoBox from "../components/BentoBox.astro";
import { getCollection, type CollectionEntry } from "astro:content";

const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort(
  (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
type BlogPost = CollectionEntry<"blog">;
const pageTitle = "Blog";
---

<BaseLayout pageTitle={pageTitle}>
  <section
    class="flex flex-col items-start gap-6 max-w-3xl py-12 md:py-20 mb-12"
  >
    <h2 class="text-4xl md:text-6xl font-mono font-bold text-mocha-mauve">
      Blog
    </h2>
    <p class="text-lg md:text-xl opacity-80">
      Tech guides, dev logs, personal anecdotes, and everything in between.
    </p>
  </section>

  <section class="bg-mocha-surface-0 p-8 md:p-12 rounded-3xl shadow-xl shadow-mocha-crust/20 mb-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-min">
      {
        sortedPosts.map((post: BlogPost) => (
          <BentoBox
            href={`/blog/${post.slug}`}
            class="hover:border-mocha-surface-2 bg-mocha-base h-full"
            icon={post.data.icon}
            title={post.data.title}
            iconColor={post.data.color}
          >
            {post.data.desc}
          </BentoBox>
        ))
      }
    </div>
  </section>
</BaseLayout>
