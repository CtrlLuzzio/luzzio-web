---
import BaseLayout from "../../layouts/Base.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";

import { formatGameName, getTournamentName } from "../../utils/blogMeta";

export async function getStaticPaths() {
  return [{ params: { page: undefined } }];
}

const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const tournamentLabels: Record<string, string> = {};
await Promise.all(
  sortedPosts.map(async (post) => {
    if (post.data.tournament) {
      const tName = await getTournamentName(post.data.tournament);
      const gName = post.data.tournamentGame
        ? formatGameName(post.data.tournamentGame)
        : null;
      tournamentLabels[post.id] = gName ? `${tName} (${gName})` : tName;
    }
  })
);

const tagCounts = new Map<string, number>();
for (const post of sortedPosts) {
  const uniquePostTags = new Set(
    post.data.tags.map((t) => t.trim().toLowerCase()).filter(Boolean)
  );
  for (const tag of uniquePostTags) {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  }
}

const sortedTags = Array.from(tagCounts.entries())
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([tag, count]) => ({ tag, count }));

const MAX_VISIBLE_TAGS = 8;
const hiddenTagsCount = Math.max(0, sortedTags.length - MAX_VISIBLE_TAGS);

const PAGE_SIZE = 5;
const initialTotalPages = Math.max(1, Math.ceil(sortedPosts.length / PAGE_SIZE));
const pageTitle = "Blog";
---

<BaseLayout pageTitle={pageTitle}>
  <section class="flex flex-col items-start gap-6 max-w-3xl py-12 md:py-20 mb-4">
    <h1 class="text-4xl md:text-6xl font-mono font-bold text-catp-mauve">
      Blog
    </h1>
    <p class="text-lg md:text-xl text-catp-subtext-1">
      Tech guides, dev logs, personal anecdotes, and everything in between.
    </p>
  </section>

  <section class="bg-catp-surface-0 p-8 md:p-12 rounded-3xl shadow-xl shadow-catp-shadow/20 mb-20 flex flex-col gap-8">
    <div class="flex flex-col gap-5 pb-6 border-b border-catp-surface-2">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div class="relative w-full lg:w-80">
          <Icon
            name="tabler:search"
            class="w-4 h-4 text-catp-subtext-0 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none"
          />
          <input
            type="search"
            id="post-search-input"
            placeholder="Search posts..."
            aria-label="Search posts"
            class="w-full pl-10 pr-4 py-2 bg-catp-crust border border-catp-surface-1 rounded-xl font-mono text-sm text-catp-text placeholder:text-catp-subtext-0 focus:outline-none focus:border-catp-mauve transition-colors"
          />
        </div>

        <div class="flex flex-wrap items-center gap-2 font-mono text-sm">
          <span class="text-catp-subtext-0 mr-1 flex items-center gap-1.5">
            <Icon name="tabler:filter" class="w-4 h-4 text-catp-mauve" />
            Category:
          </span>
          <button
            type="button"
            data-filter-type="all"
            data-active=""
            aria-pressed="true"
            class="px-4 py-1.5 rounded-full border border-catp-overlay-0 text-catp-subtext-0 hover:text-catp-text hover:border-catp-mauve transition-all cursor-pointer data-[active]:bg-catp-mauve data-[active]:text-catp-crust data-[active]:font-bold data-[active]:border-transparent"
          >
            All Posts
          </button>
          <button
            type="button"
            data-filter-type="project"
            aria-pressed="false"
            class="px-4 py-1.5 rounded-full border border-catp-overlay-0 text-catp-subtext-0 hover:text-catp-text hover:border-catp-teal transition-all cursor-pointer flex items-center gap-1.5 data-[active]:bg-catp-teal data-[active]:text-catp-crust data-[active]:font-bold data-[active]:border-transparent"
          >
            <Icon name="tabler:terminal" class="w-4 h-4" />
            Project Devlogs
          </button>
          <button
            type="button"
            data-filter-type="tournament"
            aria-pressed="false"
            class="px-4 py-1.5 rounded-full border border-catp-overlay-0 text-catp-subtext-0 hover:text-catp-text hover:border-catp-red transition-all cursor-pointer flex items-center gap-1.5 data-[active]:bg-catp-red data-[active]:text-catp-crust data-[active]:font-bold data-[active]:border-transparent"
          >
            <Icon name="tabler:trophy" class="w-4 h-4" />
            Tournament Blogs
          </button>
        </div>
      </div>

      {sortedTags.length > 0 && (
        <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
          <span class="text-catp-subtext-0 mr-1 flex items-center gap-1.5 text-sm">
            <Icon name="tabler:tag" class="w-4 h-4 text-catp-blue" />
            Tags:
          </span>

          <div class="relative w-full sm:w-44 mr-1">
            <Icon
              name="tabler:search"
              class="w-3.5 h-3.5 text-catp-subtext-0 absolute left-2.5 top-1/2 -translate-y-1/2 pointer-events-none"
            />
            <input
              type="search"
              id="tag-search-input"
              placeholder="Filter tags..."
              aria-label="Filter tags"
              class="w-full pl-8 pr-2.5 py-1 bg-catp-crust border border-catp-surface-1 rounded-lg font-mono text-xs text-catp-text placeholder:text-catp-subtext-0 focus:outline-none focus:border-catp-blue transition-colors"
            />
          </div>

          {sortedTags.map(({ tag, count }, index) => (
            <button
              type="button"
              data-filter-tag={tag}
              data-extra-tag={index >= MAX_VISIBLE_TAGS ? "" : undefined}
              aria-pressed="false"
              class:list={[
                "px-3 py-1 rounded-lg bg-catp-crust border border-catp-surface-1 text-catp-subtext-0 hover:text-catp-text hover:border-catp-blue transition-all cursor-pointer items-center gap-1.5 data-[active]:bg-catp-blue data-[active]:text-catp-crust data-[active]:font-bold data-[active]:border-transparent",
                index >= MAX_VISIBLE_TAGS ? "hidden" : "inline-flex",
              ]}
            >
              <span>#{tag}</span>
              <span class="opacity-60">({count})</span>
            </button>
          ))}

          <span id="no-tags-msg" class="hidden text-catp-subtext-0 italic py-1">
            No matching tags
          </span>

          {hiddenTagsCount > 0 && (
            <button
              type="button"
              id="toggle-tags-btn"
              data-hidden-count={hiddenTagsCount}
              aria-expanded="false"
              class="px-3 py-1 rounded-lg bg-catp-surface-0 hover:bg-catp-surface-1 border border-catp-surface-2 text-catp-teal font-bold transition-colors cursor-pointer inline-flex items-center gap-1"
            >
              <span id="toggle-tags-text">+{hiddenTagsCount} more</span>
              <Icon
                name="tabler:chevron-down"
                id="toggle-tags-icon"
                class="w-3.5 h-3.5 transition-transform duration-300"
              />
            </button>
          )}

          <button
            type="button"
            id="clear-tags-btn"
            class="hidden px-2.5 py-1 rounded-lg text-catp-red hover:bg-catp-red/10 transition-colors cursor-pointer items-center gap-1"
          >
            <Icon name="tabler:x" class="w-3.5 h-3.5" />
            <span>Clear tags</span>
          </button>
        </div>
      )}
    </div>

    <div id="blog-posts-list" class="flex flex-col gap-6" data-page-size={PAGE_SIZE}>
      {sortedPosts.map((post, index) => {
        const normalizedTags = post.data.tags.map((t) => t.trim().toLowerCase());
        const hasProject = Boolean(post.data.projectRepo);
        const hasTournament = Boolean(post.data.tournament);

        return (
          <a
            href={`/blog/${post.id}`}
            data-post-card
            data-title={post.data.title.trim().toLowerCase()}
            data-has-project={String(hasProject)}
            data-has-tournament={String(hasTournament)}
            data-tags={normalizedTags.join(",")}
            class:list={[
              "flex-col md:flex-row items-center md:items-start gap-6 p-6 rounded-2xl bg-catp-base border-2 border-transparent hover:border-catp-surface-2 transition-all group w-full",
              index < PAGE_SIZE ? "flex" : "hidden",
            ]}
          >
            <div class="shrink-0 w-24 h-24 md:w-32 md:h-32 rounded-xl flex items-center justify-center">
              <Icon name={post.data.icon} class={`w-16 h-16 md:w-32 md:h-32 ${post.data.color}`} />
            </div>

            <div class="flex flex-col justify-center flex-1 w-full text-center md:text-left h-full py-2">
              <div class="flex flex-wrap items-center justify-center md:justify-start gap-2 mb-2 font-mono text-xs">
                <span class="text-sm text-catp-subtext-0 mr-1">
                  {post.data.pubDate.toLocaleDateString()}
                </span>

                {hasProject && (
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-catp-crust text-catp-teal border border-catp-surface-0">
                    <Icon name="tabler:terminal" class="w-3.5 h-3.5" />
                    {post.data.projectRepo}
                  </span>
                )}

                {hasTournament && (
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-catp-crust text-catp-red border border-catp-surface-0">
                    <Icon name="tabler:trophy" class="w-3.5 h-3.5" />
                    {tournamentLabels[post.id]}
                  </span>
                )}
              </div>

              <h2
                transition:name={`post-title-${post.id}`}
                class="text-2xl md:text-3xl font-mono font-bold text-catp-text group-hover:text-catp-blue transition-colors mb-3"
              >
                {post.data.title}
              </h2>

              <p class="text-catp-subtext-1 text-base md:text-lg mb-3">
                {post.data.desc}
              </p>

              {normalizedTags.length > 0 && (
                <div class="flex flex-wrap justify-center md:justify-start gap-2.5 mt-4 pt-3 border-t border-catp-surface-0">
                  {normalizedTags.map((tag) => (
                    <span class="font-mono text-xs text-catp-subtext-0 bg-catp-crust px-2.5 py-1 rounded border border-catp-surface-0">
                      #{tag}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </a>
        );
      })}
    </div>

    <div
      id="blog-empty-state"
      class="hidden p-8 rounded-2xl text-center"
    >
      <p class="text-catp-subtext-0 font-mono">
        No posts found matching the selected filters.
      </p>
    </div>

    <nav
      id="blog-pagination"
      aria-label="Pagination"
      class:list={[
        "items-center justify-between pt-8 border-t border-catp-surface-2 font-mono",
        initialTotalPages > 1 ? "flex" : "hidden",
      ]}
    >
      <button
        type="button"
        id="blog-page-prev"
        disabled
        aria-label="Previous page"
        class="flex items-center gap-2 px-6 py-3 bg-catp-base hover:bg-catp-crust rounded-lg transition-colors border border-catp-surface-0 hover:border-catp-surface-2 cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-catp-base disabled:hover:border-catp-surface-0"
      >
        <Icon name="tabler:arrow-left" class="w-5 h-5" />
        <span class="hidden md:inline">Prev</span>
      </button>

      <span id="blog-page-indicator" class="text-catp-subtext-0">
        Page 1 of {initialTotalPages}
      </span>

      <button
        type="button"
        id="blog-page-next"
        aria-label="Next page"
        class="flex items-center gap-2 px-6 py-3 bg-catp-base hover:bg-catp-crust rounded-lg transition-colors border border-catp-surface-0 hover:border-catp-surface-2 cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-catp-base disabled:hover:border-catp-surface-0"
      >
        <span class="hidden md:inline">Next</span>
        <Icon name="tabler:arrow-right" class="w-5 h-5" />
      </button>
    </nav>
  </section>
</BaseLayout>

<script src="../../scripts/blogFilter.ts"></script>