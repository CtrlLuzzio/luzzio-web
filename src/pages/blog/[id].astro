---
import { getCollection, render } from "astro:content";
import BlogpostLayout from "../../layouts/Blogpost.astro";
import { filterPostsByLang } from "../../utils/blogMeta";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const localizedPosts = filterPostsByLang(posts, "en");
  return localizedPosts.map((post) => ({
    params: { id: post.cleanSlug },
    props: { post, cleanSlug: post.cleanSlug },
  }));
}

const { post, cleanSlug } = Astro.props;
const { Content } = await render(post);
---

<BlogpostLayout frontmatter={post.data} postId={cleanSlug}>
  <Content />
</BlogpostLayout>